        "@mattermost/eslint-plugin": "1.1.0-0",
        "@mattermost/types": "11.9.0",
        "@types/react": "18.2.64",
        "@types/react-dom": "18.2.25",
        "@typescript-eslint/eslint-plugin": "7.18.0",
        "@typescript-eslint/parser": "7.18.0",
        "@vitest/coverage-v8": "5.0.1",
        "babel-loader": "9.1.2",
        "css-loader": "6.11.0",
        "eslint": "8.57.1",
