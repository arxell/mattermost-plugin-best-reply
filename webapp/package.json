{
    "name": "mattermost-plugin-best-reply",
    "private": true,
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "webpack --mode=production",
        "debug": "webpack --mode=development",
        "build:watch": "webpack --mode=development --watch",
        "lint": "eslint --ext .ts,.tsx src",
        "fix": "eslint --ext .ts,.tsx src --fix",
        "check-types": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "coverage": "vitest run --coverage"
    },
    "devDependencies": {
        "@babel/core": "7.25.2",
        "@babel/preset-env": "7.25.4",
        "@babel/preset-react": "7.24.7",
        "@babel/preset-typescript": "7.24.7",
        "@mattermost/types": "10.6.0",
        "@types/react": "18.2.64",
        "@types/react-dom": "^18.2.25",
        "@vitest/coverage-v8": "^5.0.1",
        "babel-loader": "9.1.2",
        "css-loader": "6.11.0",
        "jsdom": "^30.1.0",
        "react-dom": "^18.2.0",
        "sass": "1.77.8",
        "sass-loader": "13.3.3",
        "style-loader": "3.3.4",
        "typescript": "5.5.4",
        "vitest": "^5.0.1",
        "webpack": "5.95.0",
        "webpack-cli": "5.1.4"
    },
    "dependencies": {
        "core-js": "3.50.0",
        "react": "18.2.0",
        "react-redux": "9.1.2",
        "redux": "5.0.1"
    }
}
